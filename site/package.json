{
  "name": "kumar-manthan-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && node scripts/clean-build.mjs && vite build && node scripts/build-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "dev:api": "node --import tsx server/local-dev.ts",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node --import tsx scripts/migrate-local.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.12",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.45.4",
    "tsx": "^4.20.6",
    "@cloudflare/workers-types": "^4.20251008.0",
    "@types/node": "^22.18.0"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
